# Primary Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Fallback Provider: OpenRouter (NVIDIA Nemotron)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# SQLite Database connection string
# Local development: sqlite:///./app.db
# Docker container: sqlite:////data/app.db
DATABASE_URL=sqlite:///./app.db

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Failure simulation toggle (set to true to enable X-Simulate-Failure header)
ENABLE_FAILURE_SIMULATION=true

# Response caching toggle
LITELLM_CACHE_ENABLED=true

# Server host & port
HOST=0.0.0.0
PORT=8000
